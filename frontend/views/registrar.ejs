<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>Registro de Participante</h1>
    </header>
    <main>
        <form id="registerForm">
            <div class="form-group">
                <label for="nickname">Nickname</label>
                <input type="text" id="nickname" name="nickname" required placeholder="Tu apodo de jugador">
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required placeholder="correo@ejemplo.com">
            </div>
            <div class="form-group">
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre">
            </div>
            <div class="form-group">
                <label for="apellido">Apellido</label>
                <input type="text" id="apellido" name="apellido" required placeholder="Tu apellido">
            </div>
            <div class="form-group">
                <label for="pais">Selecciona tu País (Participante 2026)</label>
                <select id="pais" name="pais" required>
                    <option value="">-- Elige un país --</option>
                    <% countries.forEach(country => { %>
                        <option value="<%= country %>">
                             <%= country %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <div id="selectedFlag" style="text-align: center; margin-bottom: 1rem; min-height: 50px;">
                <!-- Flag will appear here via JS -->
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">Registrar</button>
        </form>
        <div style="margin-top: 2rem; text-align: center;">
            <a href="/" class="btn btn-home">Volver al Inicio</a>
        </div>
    </main>

    <script>
        const countryFlags = <%- JSON.stringify(countryFlags) %>;
        const paisSelect = document.getElementById('pais');
        const selectedFlagDiv = document.getElementById('selectedFlag');

        paisSelect.addEventListener('change', (e) => {
            const country = e.target.value;
            if (country && countryFlags[country]) {
                const code = countryFlags[country];
                selectedFlagDiv.innerHTML = `<img src="https://flagcdn.com/w80/${code}.png" alt="${country}" style="box-shadow: 0 2px 5px rgba(0,0,0,0.2);">`;
            } else {
                selectedFlagDiv.innerHTML = '';
            }
        });

        document.getElementById('registerForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());
            
            console.log('Enviando datos al backend (simulado):', data);
            
            try {
                const response = await fetch('/api/registrar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                alert(result.message + '. ¡Mucha suerte!');
                window.location.href = '/quinielazo';
            } catch (err) {
                console.error('Error:', err);
                alert('Error al registrar. Intenta de nuevo.');
            }
        });
    </script>
</body>
</html>
